#!/usr/bin/env bash

# do test by default
TEST_PULL=true

while getopts 'pt' OPTION; do

    case "$OPTION" in
    p)
        TEST_PULL=false
        shift 1
        ;;

    t)
        TEST_PULL=true
        shift 1
        ;;

    ?)
        echo "Usage: $(basename $0) <src_directory> <dest_directory>"
        echo "    Securely backs up a source directory to a destination directory, doing a test by default (does not change files unless specifically given the flag to do so)."
        echo "FLAGS:"
        echo "    [-p] # Perform pull (CHANGES FILES)"
        echo "    [-t] # (BY DEFAULT) Test pull (does not change any files)"
        exit 1
        ;;
    esac
done

if [ "$#" -lt 2 ]; then
    echo "Usage: $(basename $0) <src_directory> <dest_directory>"
    echo "    Securely backs up a source directory to a destination directory, doing a test by default (does not change files unless specifically given the flag to do so)."
    echo "FLAGS:"
    echo "    [-p] # Perform pull (CHANGES FILES)"
    echo "    [-t] # (BY DEFAULT) Test pull (does not change any files)"
    exit 1
fi

SRC_DIRECTORY="$1"
DEST_DIRECTORY="$2"

if [ ! -d "$SRC_DIRECTORY" ]; then
    echo "source directory: $SRC_DIRECTORY does not exist!"
    exit 1
fi

if [ ! -d "$DEST_DIRECTORY" ]; then
    echo "source directory: $DEST_DIRECTORY does not exist!"
    exit 1
fi

if $TEST_PULL; then
    echo "---Performing test from $SRC_DIRECTORY directory to $DEST_DIRECTORY---"
    # perform test pull
    rsync -raz --dry-run --update --progress "$SRC_DIRECTORY" "$DEST_DIRECTORY"
else
    # prompt the user if they are sure that they want to do this action
    echo "---backup $SRC_DIRECTORY directory to $DEST_DIRECTORY---"
    echo "(does not delete any files, only updates when there are changes and creates new ones if they do not exist)"
    echo
    read -p "Are you sure (y/n)? " -n 1 -r
    # newlines
    echo
    echo

    # if we got a yes reply, then do the pull/test
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        echo "---Performing pull---"
        # syncs files to their newest versions if they exist
        # and creates files if they did not exist before
        # NOTE: --update prevents rsync from deleting files that were deleted, so things can only be added
        # WARNING: could cause issues, so add --dry-run to see if there are errors beforehand
        rsync -raz --update --progress "$SRC_DIRECTORY" "$DEST_DIRECTORY"
    fi
fi

# make sure that it is actually done
# NOTE: VERY IMPORTANT, THIS PREVENTS DATA FROM BEING LOST WHEN BACKING UP TO SLOW DRIVES (such as flash drives)

# change to the destination directory so we can do the sync there to be safe
cd "$DEST_DIRECTORY"

echo "syncing..."
sync &
pid=$!

# If this script is killed, kill the `sync'.
trap "kill $pid 2>/dev/null" EXIT

# spinner strings
spin[0]="-"
spin[1]="\\"
spin[2]="|"
spin[3]="/"

# while the sync is still running, spin
while kill -0 $pid 2>/dev/null; do
    for i in "${spin[@]}"; do
        echo -ne "\b$i"
        sleep 0.25
    done
done

# success!
echo -e "\rBackup successful!"

# disable the trap when a normal exit occurs
trap - EXIT
