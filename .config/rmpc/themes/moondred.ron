#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    show_song_table_header: true,
    draw_borders: true,
    format_tag_separator: " | ",
    browser_column_widths: [20, 38, 42],
    background_color: "#120e16",
    text_color: "#dab8fc",
    header_background_color: None,
    modal_background_color: None,
    modal_backdrop: true,
    preview_label_style: (fg: "#fc6f6f"),
    preview_metadata_group_style: (fg: "#7e80fc", modifiers: "Bold"),
    tab_bar: (
        enabled: true,
        active_style: (fg: "black", bg: "#c17efc", modifiers: "Bold"),
        inactive_style: (fg: "#dab8fc"),
    ),
    highlighted_item_style: (fg: "#c17efc", modifiers: "Bold"),
    current_item_style: (fg: "black", bg: "#c17efc", modifiers: "Bold"),
    borders_style: (fg: "#c17efc"),
    highlight_border_style: (fg: "#c17efc"),
    symbols: (
        song: "S",
        dir: "D",
        playlist: "P",
        marker: "M",
        ellipsis: "...",
        song_style: None,
        dir_style: None,
        playlist_style: None,
    ),
    level_styles: (
        info: (fg: "blue", bg: "black"),
        warn: (fg: "yellow", bg: "black"),
        error: (fg: "red", bg: "black"),
        debug: (fg: "light_green", bg: "black"),
        trace: (fg: "magenta", bg: "black"),
    ),
    progress_bar: (
        symbols: ["{", "-", "»", " ", "}"],
        track_style: (fg: "#7e80fc", bg: "#1e2030"),
        elapsed_style: (fg: "#7e80fc", bg: "#1e2030"),
        thumb_style: (fg: "#7e80fc", bg: "#1e2030"),
    ),
    scrollbar: (
        symbols: ["│", "█", "▲", "▼"],
        track_style: (fg: "#dab8fc"),
        ends_style: (fg: "#dab8fc"),
        thumb_style: (fg: "#c17efc"),
    ),
    song_table_format: [
        (
            prop: (kind: Property(Artist), style: (fg: "#fc6f6f"),
                default: (kind: Text("<<Unknown>>"), style: (fg: "#fc6f6f"))
            ),
            width: "20%",
        ),
        (
            prop: (kind: Property(Title), style: (fg: "#dab8fc"),
                default: (kind: Text("<<Unknown>>"), style: (fg: "#dab8fc"))
            ),
            width: "35%",
        ),
        (
            prop: (kind: Property(Album), style: (fg: "#7e80fc"),
                default: (kind: Text("<<Unknown Album>>"), style: (fg: "#7e80fc"))
            ),
            width: "30%",
        ),
        (
            prop: (kind: Property(Duration), style: (fg: "#dab8fc"),
                default: (kind: Text("-"), style: (fg: "#dab8fc"))
            ),
            width: "15%",
            alignment: Right,
        ),
    ],
    components: {},
    layout: Split(
        direction: Vertical,
        panes: [
            (
                pane: Pane(Header),
                size: "2",
            ),
            (
                pane: Pane(Tabs),
                size: "3",
            ),
            (
                pane: Pane(TabContent),
                size: "100%",
            ),
            (
                pane: Pane(ProgressBar),
                size: "1",
            ),
        ],
    ),
    header: (
        rows: [
            (
                left: [
                    (kind: Text("["), style: (fg: "#fc6f6f", modifiers: "Bold")),
                    (kind: Property(Status(StateV2(playing_label: "Playing", paused_label: "Paused", stopped_label: "Stopped"))), style: (fg: "#fc6f6f", modifiers: "Bold")),
                    (kind: Text("]"), style: (fg: "#fc6f6f", modifiers: "Bold"))
                ],
                center: [
                    (kind: Property(Song(Title)), style: (fg: "#dab8fc", modifiers: "Bold"),
                        default: (kind: Text("No Song"), style: (fg: "#dab8fc", modifiers: "Bold"))
                    )
                ],
                right: [
                    (kind: Property(Widget(ScanStatus)), style: (fg: "#c17efc")),
                    (kind: Property(Widget(Volume)), style: (fg: "#c17efc"))
                ]
            ),
            (
                left: [
                    (kind: Property(Status(Elapsed)), style: (fg: "#e48dfc")),
                    (kind: Text(" / "), style: (fg: "#e48dfc")),
                    (kind: Property(Status(Duration)), style: (fg: "#e48dfc")),
                    (kind: Text(" ("), style: (fg: "#e48dfc")),
                    (kind: Property(Status(Bitrate)), style: (fg: "#e48dfc")),
                    (kind: Text(" kbps)"), style: (fg: "#e48dfc"))
                ],
                center: [
                    (kind: Property(Song(Artist)), style: (fg: "#fc6f6f", modifiers: "Bold"),
                        default: (kind: Text("Unknown"), style: (fg: "#fc6f6f", modifiers: "Bold"))
                    ),
                    (kind: Text(" - "), style: (fg: "#dab8fc")),
                    (kind: Property(Song(Album)), style: (fg: "#7e80fc"),
                        default: (kind: Text("Unknown Album"), style: (fg: "#7e80fc"))
                    )
                ],
                right: [
                    (
                        kind: Property(Widget(States(
                            active_style: (fg: "#e48dfc", modifiers: "Bold"),
                            separator_style: (fg: "#dab8fc")))
                        ),
                        style: (fg: "#674072")
                    ),
                ]
            ),
        ],
    ),
    browser_song_format: [
        (
            kind: Group([
                (kind: Property(Track)),
                (kind: Text(" ")),
            ])
        ),
        (
            kind: Group([
                (kind: Property(Artist)),
                (kind: Text(" - ")),
                (kind: Property(Title)),
            ]),
            default: (kind: Property(Filename))
        ),
    ],
    lyrics: (
        timestamp: false
    )
)
